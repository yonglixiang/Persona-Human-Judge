{
  "name": "persona-human-judge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc",
    "check": "tsc --noEmit && node --check web/app.js && node --check web/api.js && node --check web/i18n.js && node --check web/views.js",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build:web": "node scripts/build-web.mjs",
    "config:deploy": "node scripts/deploy-config.mjs",
    "deploy": "wrangler deploy --config .deploy/wrangler.json",
    "db:migrate": "wrangler d1 migrations apply DB --remote --config .deploy/wrangler.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  }
}
